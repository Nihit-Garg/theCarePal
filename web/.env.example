# Copy to web/.env (never commit .env). Everything here is optional.

# --- Shared incidents across devices (docs/FIREBASE.md) ---------------------------
# Without these, incidents sync between tabs of the same browser only.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- Webhook ------------------------------------------------------------------------
# Also POST each escalated alert here (e.g. a Cloud Function that sends an FCM push or SMS).
VITE_ALERT_WEBHOOK_URL=

# --- Hosting ------------------------------------------------------------------------
# Base path when hosting under a sub-path (GitHub Pages: /theCarePal/). Default "/".
VITE_BASE=/
