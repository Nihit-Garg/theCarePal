# Optional. Where to POST an alert when the 30 s countdown expires (or "Get help now").
# e.g. a Firebase Cloud Function that writes to Firestore + sends an FCM push to the nurse app.
# Leave empty to run the demo without sending anything.
VITE_ALERT_WEBHOOK_URL=
# Base path when hosting under a sub-path (e.g. GitHub Pages: /theCarePal/). Default "/".
VITE_BASE=/
