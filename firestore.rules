rules_version = '2';
// Firestore security rules for FallGuard incidents (see docs/FIREBASE.md).
// DEMO LEVEL: any signed-in client (anonymous auth) can read all incidents and
// create/update them. What the rules do enforce:
//   * documents are well-formed (id, person, createdAt, status, events)
//   * id, person and createdAt can never change after creation
//   * the event timeline can only grow (history can't be rewritten or shortened)
//   * nothing can be deleted
// Production: replace anonymous auth with TheCarePal accounts and restrict each
// incident to the person's care team, e.g. request.auth.uid in resource.data.careTeam.
service cloud.firestore {
  match /databases/{database}/documents {
    match /incidents/{incidentId} {
      function wellFormed(d) {
        return d.id == incidentId
          && d.person is string
          && d.createdAt is number
          && d.status in ['countdown', 'cancelled', 'escalated', 'acknowledged', 'resolved']
          && d.events is list
          && d.events.size() <= 50;
      }
      allow read: if request.auth != null;
      allow create: if request.auth != null && wellFormed(request.resource.data);
      allow update: if request.auth != null && wellFormed(request.resource.data)
        && request.resource.data.person == resource.data.person
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.events.size() >= resource.data.events.size();
      allow delete: if false;
    }
  }
}
