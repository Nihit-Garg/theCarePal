rules_version = '2';
// Firestore security rules for FallGuard incidents (see docs/FIREBASE.md).
// Demo level: any signed-in client (anonymous auth) can read and write incidents,
// but documents must be well-formed and can never be deleted (audit trail).
// Production: replace anonymous auth with TheCarePal accounts and restrict each
// incident to the person's care team, e.g. request.auth.uid in resource.data.careTeam.
service cloud.firestore {
  match /databases/{database}/documents {
    match /incidents/{incidentId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.id == incidentId
        && request.resource.data.person is string
        && request.resource.data.createdAt is number
        && request.resource.data.status in ['countdown', 'cancelled', 'escalated', 'acknowledged', 'resolved']
        && request.resource.data.events is list
        && request.resource.data.events.size() <= 50;
      allow delete: if false;
    }
  }
}
